      <mxGeometry x="1560" y="20" width="320" height="200" as="geometry" />
    </mxCell>
    <mxCell id="n_leg1" value="Anthropic (cloud sandbox)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DFF5;strokeColor=#7C5CBF;fontColor=#3D2A5C;fontSize=11;" vertex="1" parent="n_legendBg">
      <mxGeometry x="10" y="32" width="300" height="30" as="geometry" />
